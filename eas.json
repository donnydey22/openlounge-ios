{
  "cli": {
    "version": ">= 24.11.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "autoIncrement": true,
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "ios": {
        "buildConfiguration": "Release",
        "enterpriseProvisioning": "adhoc",
        "credentialsSource": "local"
      }
    },
    "production": {
      "distribution": "store",
      "developmentClient": false,
      "autoIncrement": true,
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "ios": {
        "buildConfiguration": "Release",
        "credentialsSource": "local"
      }
    },
    "staging": {
      "extends": "preview",
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "OL_START_URL": "https://openlounge-staging-native-media-staging.up.railway.app"
      }
    },
    "staging-store": {
      "extends": "production",
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "OL_START_URL": "https://openlounge-staging-native-media-staging.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
