{
  "expo": {
    "name": "Open Lounge",
    "slug": "openlounge",
    "scheme": "openlounge",
    "version": "0.3.19",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1C1C1E",
    "ios": {
      "bundleIdentifier": "com.donnydey.openlounge",
      "buildNumber": "20",
      "deploymentTarget": "16.4",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/app-icon/ios-1024.png",
        "dark": "./assets/app-icon/ios-1024-dark.png",
        "tinted": "./assets/app-icon/ios-1024-tinted.png"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Open Lounge uses your microphone so you can speak in live rooms, drop-in chats and calls. Audio is only sent while you\u2019re speaking on stage or in a call.",
        "NSCameraUsageDescription": "Open Lounge uses your camera when you turn on video in a call or take a photo, for example for your profile picture.",
        "NSPhotoLibraryUsageDescription": "Open Lounge lets you pick a photo, for example for your profile picture.",
        "UIBackgroundModes": [
          "audio",
          "remote-notification",
          "voip"
        ],
        "UIStatusBarStyle": "UIStatusBarStyleDefault",
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSContactsUsageDescription": "Open Lounge uses the phone numbers in your contacts to show which friends are already here and, if you turn on \u201cTell me when contacts join\u201d, to let you know when one joins. Numbers are sent only as one-way codes, never shared, and you can delete them anytime.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Open Lounge uses Face ID to unlock the app when you turn on App lock."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhoneNumber",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailsOrTextMessages",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeContacts",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeAudioData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.donnydey.openlounge",
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1E",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Open Lounge uses Face ID to unlock the app when you turn on App lock."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#F4F3EE",
          "dark": {
            "image": "./assets/splash-blank.png",
            "backgroundColor": "#0B0B0D"
          }
        }
      ],
      "./plugins/withSafeFirebaseConfigure.js",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/auth",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F2B366"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Open Lounge uses the phone numbers in your contacts to show which friends are already here and, if you turn on \u201cTell me when contacts join\u201d, to let you know when one joins. Numbers are sent only as one-way codes, never shared, and you can delete them anytime."
        }
      ],
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "networkInspector": false,
            "useFrameworks": "static",
            "deploymentTarget": "16.4"
          },
          "android": {
            "networkInspector": false
          }
        }
      ],
      "./plugins/withRNFirebaseDisableSPM.js",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Open Lounge uses Face ID to unlock the app when you turn on App lock."
        }
      ],
      "./plugins/withFirebasePhoneAuthScheme.js"
    ],
    "extra": {
      "startUrl": "https://openlounge.app",
      "eas": {
        "projectId": "f753053a-9047-4cd5-b232-7f0aa067dfb7"
      }
    },
    "owner": "donnydey"
  }
}
