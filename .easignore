# EAS project archive ignore (replaces .gitignore when present).
# Same as .gitignore (the old WebRTC.xcframework un-ignore is gone with the WebRTC path; olcall Frameworks/ stay
# ignored here too: an EAS build must unpack TgVoipWebrtc.xcframework the way CI does).

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local iOS signing (secrets)
credentials.json
credentials/

# (old WebRTC.xcframework entry removed 2026-11-10)
# Negation patterns (belt-and-suspenders if a parent rule ever matches):
