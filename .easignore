# EAS project archive ignore (replaces .gitignore when present).
# Same as .gitignore EXCEPT WebRTC.xcframework is INCLUDED so eas build --local
# packs the pre-fetched M152 framework (gitignored in the repo to avoid ~96MB commits).

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local iOS signing (secrets)
credentials.json
credentials/

# WebRTC: intentionally NOT ignored here — CI fetches before eas --local.
# Negation patterns (belt-and-suspenders if a parent rule ever matches):
!modules/openlounge-call-engine/ios/WebRTC.xcframework/
!modules/openlounge-call-engine/ios/WebRTC.xcframework/**
